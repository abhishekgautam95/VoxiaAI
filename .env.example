# Copy this file to `.env` before running Prisma commands. Use a restricted
# application user in every environment.
# PostgreSQL connection string.
DATABASE_URL="postgresql://voxia:replace-me@localhost:5432/voxia?schema=public"

# Session lifetime in days. Rotate the database and application secrets outside source control.
SESSION_TTL_DAYS="14"

# Initial owner bootstrap (used only by `npm run db:seed-admin`). Never commit values.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Workspace Owner"
ORGANIZATION_NAME="Example Organization"
ORGANIZATION_SLUG="example-organization"

# Public Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Subscription Billing & Webhooks (Optional in local dev; required for live checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER="price_starter_199"
STRIPE_PRICE_PRO="price_pro_499"
STRIPE_PRICE_ENTERPRISE="price_enterprise_999"

# Google Calendar OAuth2 2-Way Sync (Optional in local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/calendar/google/callback"

# Twilio Telephony Carrier, Signature Verification & Media Streams
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_ENFORCE_SIGNATURE="false"
TELEPHONY_CONTEXT_SECRET="replace-with-strong-hmac-secret"
ENABLE_TWILIO_MEDIA_STREAMS="false"
MEDIA_STREAM_WSS_URL="wss://stream.voxia.ai/media-stream"
